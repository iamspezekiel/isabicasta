      "contentHeight": 1000
    },
    "var_da2e2dab5870": {
      "type": "variant",
      "label": "How it works · local & offline · Dark",
      "parentId": "var_bc16d8701394",
      "themeId": null,
      "rect": {
        "x": 2375,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n</style>\n<div class=\"min-h-[812px] w-full bg-[#151814] font-['Inter',system-ui,-apple-system,sans-serif] text-[#ece7dd] antialiased\" data-kid=\"1\" data-name=\"app page container\">\n    <!-- Header -->\n    <header class=\"sticky top-0 z-10 border-b border-[#313a2e] bg-[#151814]/95 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"sticky header bar\">\n        <div class=\"mx-auto flex h-14 max-w-[420px] items-center justify-between px-5\" data-kid=\"1-1-1\" data-name=\"header layout row\">\n            <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-1\" data-name=\"brand logo group\">\n                <span class=\"text-[20px] leading-none text-[#d4b678]\" data-kid=\"1-1-1-1-1\" data-name=\"brand coin icon wrapper\">\n                    <i aria-hidden=\"true\" class=\"ti ti-coin\" data-kid=\"1-1-1-1-1-1\" data-name=\"coin icon\">\n                    </i>\n                </span>\n                <span class=\"font-['Source_Serif_4',Georgia,serif] text-[17px] font-semibold tracking-[-0.01em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    IsabiCasta\n                </span>\n            </div>\n            <button class=\"-mr-2 flex h-11 items-center gap-1.5 rounded-[10px] px-2 text-[15px] text-[#a6a196]\" data-kid=\"1-1-1-2\" data-name=\"back-to-home navigation button\" type=\"button\">\n                <span class=\"text-[18px] leading-none\" data-kid=\"1-1-1-2-1\" data-name=\"back arrow icon wrapper\">\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-left\" data-kid=\"1-1-1-2-1-1\" data-name=\"left arrow icon\">\n                    </i>\n                </span>\n                <span data-kid=\"1-1-1-2-2\" data-name=\"back button label text\">\n                    Home\n                </span>\n            </button>\n        </div>\n    </header>\n    <!-- Title -->\n    <div class=\"mx-auto max-w-[420px] px-5 pt-7\" data-kid=\"1-2\" data-name=\"title section container\">\n        <h1 class=\"font-['Source_Serif_4',Georgia,serif] text-[24px] font-semibold leading-[30px] tracking-[-0.02em] text-[#b9d3bc]\" data-kid=\"1-2-1\" data-name=\"page headline text\">\n            How IsabiCasta works\n        </h1>\n    </div>\n    <!-- A. Works offline -->\n    <section class=\"mx-auto max-w-[420px] px-5 pt-8\" data-kid=\"1-3\" data-name=\"works-offline section\">\n        <div class=\"flex items-start gap-3\" data-kid=\"1-3-1\" data-name=\"offline feature row\">\n            <span class=\"mt-0.5 text-[20px] leading-none text-[#a6a196]\" data-kid=\"1-3-1-1\" data-name=\"offline wifi-off icon wrapper\">\n                <i aria-hidden=\"true\" class=\"ti ti-wifi-off\" data-kid=\"1-3-1-1-1\" data-name=\"wifi-off icon\">\n                </i>\n            </span>\n            <div class=\"min-w-0\" data-kid=\"1-3-1-2\" data-name=\"offline feature text container\">\n                <h2 class=\"text-[17px] font-semibold leading-[24px]\" data-kid=\"1-3-1-2-1\" data-name=\"offline feature heading\">\n                    Works offline\n                </h2>\n                <p class=\"mt-2 text-[15.5px] leading-[26px] text-[#a6a196]\" data-kid=\"1-3-1-2-2\" data-name=\"offline feature description\">\n                    Once it has loaded, the app keeps working with no connection. You can flip a coin or cast lots even when you are offline.\n                </p>\n            </div>\n        </div>\n        <div class=\"mt-6 space-y-2 pl-[32px]\" data-kid=\"1-3-2\" data-name=\"offline status list container\">\n            <p class=\"flex items-start gap-2 text-[14px] font-medium leading-[20px]\" data-kid=\"1-3-2-1\" data-name=\"status ready row\">\n                <span class=\"mt-px text-[18px] leading-none text-[#9ec3a2]\" data-kid=\"1-3-2-1-1\" data-name=\"checkmark icon wrapper\">\n                    <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-3-2-1-1-1\" data-name=\"check icon\">\n                    </i>\n                </span>\n                <span data-kid=\"1-3-2-1-2\" data-name=\"status ready text\">\n                    App cached — ready to use offline.\n                </span>\n            </p>\n            <p class=\"text-[13px] leading-[18px] text-[#a6a196]\" data-dynamic=\"true\" data-kid=\"1-3-2-2\" data-name=\"offline preparing status text\" data-reason=\"text set by script based on offline state\">\n                Preparing offline access…\n            </p>\n            <p class=\"text-[13px] leading-[18px] text-[#a6a196]\" data-dynamic=\"true\" data-kid=\"1-3-2-3\" data-name=\"offline unavailable status text\" data-reason=\"text set by script based on offline state\">\n                Offline access unavailable — you'll need a connection to reload.\n            </p>\n        </div>\n    </section>\n    <div class=\"mx-auto mt-9 max-w-[420px] px-5\" data-kid=\"1-4\" data-name=\"section divider wrapper\">\n        <div class=\"h-px bg-[#313a2e]\" data-kid=\"1-4-1\" data-name=\"divider line\">\n        </div>\n    </div>\n    <!-- B. Saved in this browser -->\n    <section class=\"mx-auto max-w-[420px] px-5 pt-8\" data-kid=\"1-5\" data-name=\"saved-in-browser section\">\n        <div class=\"flex items-start gap-3\" data-kid=\"1-5-1\" data-name=\"browser feature row\">\n            <span class=\"mt-0.5 text-[20px] leading-none text-[#a6a196]\" data-kid=\"1-5-1-1\" data-name=\"history icon wrapper\">\n                <i aria-hidden=\"true\" class=\"ti ti-history\" data-kid=\"1-5-1-1-1\" data-name=\"history icon\">\n                </i>\n            </span>\n            <div class=\"min-w-0\" data-kid=\"1-5-1-2\" data-name=\"browser feature text container\">\n                <h2 class=\"text-[17px] font-semibold leading-[24px]\" data-kid=\"1-5-1-2-1\" data-name=\"browser feature heading\">\n                    Saved in this browser\n                </h2>\n                <p class=\"mt-2 text-[15.5px] leading-[26px] text-[#a6a196]\" data-kid=\"1-5-1-2-2\" data-name=\"browser feature description\">\n                    Your history is kept in this browser's local storage, on this device only. There is no account, and nothing you choose is uploaded anywhere.\n                </p>\n                <p class=\"mt-2 text-[15.5px] leading-[26px] text-[#a6a196]\" data-kid=\"1-5-1-2-3\" data-name=\"browser data clearing note\">\n                    Clearing this site's data removes it.\n                </p>\n            </div>\n        </div>\n        <button class=\"-ml-2 mt-3 flex h-11 items-center gap-2 rounded-[10px] px-2 text-[15px] font-medium text-[#e0776c]\" data-kid=\"1-5-2\" data-name=\"clear-history action button\" type=\"button\">\n            <span class=\"text-[18px] leading-none\" data-kid=\"1-5-2-1\" data-name=\"trash icon wrapper\">\n                <i aria-hidden=\"true\" class=\"ti ti-trash\" data-kid=\"1-5-2-1-1\" data-name=\"trash icon\">\n                </i>\n            </span>\n            <span data-kid=\"1-5-2-2\" data-name=\"clear-history button label\">\n                Clear saved history\n            </span>\n        </button>\n        <!-- Confirmation, shown inline -->\n        <div class=\"mt-5 border-t border-[#313a2e] pt-5\" data-kid=\"1-5-3\" data-name=\"confirmation prompt group\">\n            <p class=\"text-[14px] leading-[20px]\" data-dynamic=\"true\" data-kid=\"1-5-3-1\" data-name=\"confirmation prompt text\" data-reason=\"entry count replaced by script from saved history state\">\n                Clear 7 saved entries? This can't be undone.\n            </p>\n            <div class=\"mt-1 flex items-center gap-6 pl-0\" data-kid=\"1-5-3-2\" data-name=\"confirmation button row\">\n                <button class=\"flex h-11 items-center text-[15px] text-[#a6a196]\" data-kid=\"1-5-3-2-1\" data-name=\"cancel confirmation button\" type=\"button\">\n                    Cancel\n                </button>\n                <button class=\"flex h-11 items-center text-[15px] font-medium text-[#e0776c]\" data-kid=\"1-5-3-2-2\" data-name=\"confirm clear button\" type=\"button\">\n                    Clear history\n                </button>\n            </div>\n        </div>\n    </section>\n    <div class=\"mx-auto mt-8 max-w-[420px] px-5\" data-kid=\"1-6\" data-name=\"section divider wrapper\">\n        <div class=\"h-px bg-[#313a2e]\" data-kid=\"1-6-1\" data-name=\"divider line\">\n        </div>\n    </div>\n    <!-- C. A tool, not a prophecy -->\n    <section class=\"mx-auto max-w-[420px] px-5 pt-8\" data-kid=\"1-7\" data-name=\"tool-not-prophecy section\">\n        <div class=\"flex items-start gap-3\" data-kid=\"1-7-1\" data-name=\"tool-not-prophecy row\">\n            <span class=\"mt-0.5 text-[20px] leading-none text-[#a6a196]\" data-kid=\"1-7-1-1\" data-name=\"book icon wrapper\">\n                <i aria-hidden=\"true\" class=\"ti ti-book\" data-kid=\"1-7-1-1-1\" data-name=\"book icon\">\n                </i>\n            </span>\n            <div class=\"min-w-0\" data-kid=\"1-7-1-2\" data-name=\"tool-not-prophecy text container\">\n                <h2 class=\"text-[17px] font-semibold leading-[24px]\" data-kid=\"1-7-1-2-1\" data-name=\"tool-not-prophecy heading\">\n                    A tool, not a prophecy\n                </h2>\n                <p class=\"mt-2 text-[15.5px] leading-[26px] text-[#a6a196]\" data-kid=\"1-7-1-2-2\" data-name=\"tool-not-prophecy description\">\n                    IsabiCasta uses fair randomness to help you choose when you are stuck. It does not claim that any particular result reveals God's specific will for your life. Use it thoughtfully, alongside prayer, counsel, and wisdom.\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- D. One honest line -->\n    <div class=\"mx-auto max-w-[420px] px-5 pb-14 pt-10\" data-kid=\"1-8\" data-name=\"footer closing section\">\n        <p class=\"text-[13.5px] leading-[20px] text-[#a6a196]\" data-kid=\"1-8-1\" data-name=\"footer one-line tagline\">\n            No account, no ads, no analytics.\n        </p>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-10-16T01:57:12.598909+00:00",
      "modified": "2026-10-16T01:57:20.988457+00:00",
      "id": "var_da2e2dab5870",
      "contentHeight": 1170
    },
    "var_5b859abc33b2": {
      "type": "variant",
      "label": "Recent activity (history) · Dark",
      "parentId": "var_bc68db6d5dcc",
      "themeId": null,
      "rect": {
        "x": 1425,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&family=Inter:wght@400;500;600&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n\n  .isabi-ui {\n    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n    font-feature-settings: 'cv11', 'ss01';\n  }\n  .isabi-serif {\n    font-family: 'Source Serif 4', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;\n  }\n</style>\n<div class=\"isabi-ui min-h-[812px] bg-[#151814] text-[#ece7dd] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Header -->\n    <header class=\"sticky top-0 z-10 border-b border-[#313a2e] bg-[#151814]/95 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"sticky app header bar\">\n        <div class=\"mx-auto flex h-14 w-full max-w-[375px] items-center justify-between px-5\" data-kid=\"1-1-1\" data-name=\"header inner row\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo group\">\n                <i aria-hidden=\"true\" class=\"ti ti-coin text-[20px] leading-none text-[#d4b678]\" data-kid=\"1-1-1-1-1\" data-name=\"coin icon logo\">\n                </i>\n                <span class=\"isabi-serif text-[17px] font-semibold leading-none tracking-[-0.01em] text-[#ece7dd]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    IsabiCasta\n                </span>\n            </div>\n            <a class=\"-mr-2 flex min-h-[44px] items-center gap-1.5 px-2 text-[15px] font-medium text-[#a6a196]\" data-kid=\"1-1-1-2\" data-name=\"home navigation link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-left text-[18px] leading-none\" data-kid=\"1-1-1-2-1\" data-name=\"left arrow icon\">\n                </i>\n                Home\n            </a>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[375px] px-5 pb-10 pt-6\" data-kid=\"1-2\" data-name=\"main activity feed container\">\n        <!-- Title -->\n        <h1 class=\"isabi-serif text-[24px] font-semibold leading-[30px] tracking-[-0.015em] text-[#b9d3bc]\" data-kid=\"1-2-1\" data-name=\"page title heading\">\n            Recent activity\n        </h1>\n        <!-- Destructive action, deliberately on its own line away from the heading -->\n        <div class=\"mt-2\" data-kid=\"1-2-2\" data-name=\"destructive action wrapper\">\n            <button class=\"inline-flex min-h-[44px] items-center gap-2 text-[14px] font-medium text-[#e0776c]\" data-kid=\"1-2-2-1\" data-name=\"clear all button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-trash text-[18px] leading-none\" data-kid=\"1-2-2-1-1\" data-name=\"trash icon\">\n                </i>\n                Clear all\n            </button>\n        </div>\n        <!-- Day group: Today -->\n        <p class=\"mt-7 text-[13px] font-medium leading-[18px] text-[#a6a196]\" data-kid=\"1-2-3\" data-name=\"day group label today\">\n            Today\n        </p>\n        <ul class=\"mt-1\" data-kid=\"1-2-4\" data-name=\"activity list container\" role=\"list\">\n            <li class=\"flex items-start gap-3 py-[15px]\" data-kid=\"1-2-4-1\" data-name=\"activity list item\">\n                <i aria-hidden=\"true\" class=\"ti ti-coin mt-[3px] text-[18px] leading-none text-[#a6a196]\" data-kid=\"1-2-4-1-1\" data-name=\"coin flip icon\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-1-2\" data-name=\"activity content block\">\n                    <p class=\"isabi-serif text-[18px] font-semibold leading-[24px] text-[#ece7dd]\" data-kid=\"1-2-4-1-2-1\" data-name=\"activity result title\">\n                        Yes\n                    </p>\n                    <p class=\"mt-1 text-[13px] leading-[18px] text-[#a6a196]\" data-kid=\"1-2-4-1-2-2\" data-name=\"activity meta text\">\n                        Yes / No flip · 9:14 AM\n                    </p>\n                </div>\n            </li>\n            <li class=\"flex items-start gap-3 py-[15px]\" data-kid=\"1-2-4-2\" data-name=\"activity list item\">\n                <i aria-hidden=\"true\" class=\"ti ti-list mt-[3px] text-[18px] leading-none text-[#a6a196]\" data-kid=\"1-2-4-2-1\" data-name=\"list icon\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-2-2\" data-name=\"activity content block\">\n                    <p class=\"isabi-serif text-[18px] font-semibold leading-[24px] text-[#ece7dd]\" data-kid=\"1-2-4-2-2-1\" data-name=\"activity result title\">\n                        Go out\n                    </p>\n                    <p class=\"mt-1 text-[13px] leading-[18px] text-[#a6a196]\" data-kid=\"1-2-4-2-2-2\" data-name=\"activity meta text\">\n                        Cast lots · 3 options · 9:02 AM\n                    </p>\n                </div>\n            </li>\n            <li class=\"flex items-start gap-3 py-[15px]\" data-kid=\"1-2-4-3\" data-name=\"activity list item\">\n                <i aria-hidden=\"true\" class=\"ti ti-coin mt-[3px] text-[18px] leading-none text-[#a6a196]\" data-kid=\"1-2-4-3-1\" data-name=\"coin flip icon\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-3-2\" data-name=\"activity content block\">\n                    <p class=\"isabi-serif text-[18px] font-semibold leading-[24px] text-[#ece7dd]\" data-kid=\"1-2-4-3-2-1\" data-name=\"activity result title\">\n                        Heads\n                    </p>\n                    <p class=\"mt-1 text-[13px] leading-[18px] text-[#a6a196]\" data-kid=\"1-2-4-3-2-2\" data-name=\"activity meta text\">\n                        Heads / Tails flip · 8:47 AM\n                    </p>\n                </div>\n            </li>\n            <li class=\"flex items-start gap-3 py-[15px]\" data-kid=\"1-2-4-4\" data-name=\"activity list item\">\n                <i aria-hidden=\"true\" class=\"ti ti-list mt-[3px] text-[18px] leading-none text-[#a6a196]\" data-kid=\"1-2-4-4-1\" data-name=\"list icon\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-4-2\" data-name=\"activity content block\">\n                    <p class=\"isabi-serif text-[18px] font-semibold leading-[24px] text-[#ece7dd] break-words\" data-kid=\"1-2-4-4-2-1\" data-name=\"activity result title\">\n                        Ask a friend instead of staying home this weekend\n                    </p>\n                    <p class=\"mt-1 text-[13px] leading-[18px] text-[#a6a196]\" data-kid=\"1-2-4-4-2-2\" data-name=\"activity meta text\">\n                        Cast lots · 4 options · 8:41 AM\n                    </p>\n                </div>\n            </li>\n        </ul>\n        <!-- Day group: Oct 14 -->\n        <p class=\"mt-8 text-[13px] font-medium leading-[18px] text-[#a6a196]\" data-kid=\"1-2-5\" data-name=\"day group label Oct 14\">\n            Oct 14\n        </p>\n        <ul class=\"mt-1\" data-kid=\"1-2-6\" data-name=\"activity list container\" role=\"list\">\n            <li class=\"flex items-start gap-3 py-[15px]\" data-kid=\"1-2-6-1\" data-name=\"activity list item\">\n                <i aria-hidden=\"true\" class=\"ti ti-coin mt-[3px] text-[18px] leading-none text-[#a6a196]\" data-kid=\"1-2-6-1-1\" data-name=\"coin flip icon\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-6-1-2\" data-name=\"activity content block\">\n                    <p class=\"isabi-serif text-[18px] font-semibold leading-[24px] text-[#ece7dd]\" data-kid=\"1-2-6-1-2-1\" data-name=\"activity result title\">\n                        Yes\n                    </p>\n                    <p class=\"mt-1 text-[13px] leading-[18px] text-[#a6a196]\" data-kid=\"1-2-6-1-2-2\" data-name=\"activity meta text\">\n                        Yes / No flip · 7:28 PM\n                    </p>\n                </div>\n            </li>\n            <li class=\"flex items-start gap-3 py-[15px]\" data-kid=\"1-2-6-2\" data-name=\"activity list item\">\n                <i aria-hidden=\"true\" class=\"ti ti-list mt-[3px] text-[18px] leading-none text-[#a6a196]\" data-kid=\"1-2-6-2-1\" data-name=\"list icon\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-6-2-2\" data-name=\"activity content block\">\n                    <p class=\"isabi-serif text-[18px] font-semibold leading-[24px] text-[#ece7dd]\" data-kid=\"1-2-6-2-2-1\" data-name=\"activity result title\">\n                        Take the early train\n                    </p>\n                    <p class=\"mt-1 text-[13px] leading-[18px] text-[#a6a196]\" data-kid=\"1-2-6-2-2-2\" data-name=\"activity meta text\">\n                        Cast lots · 2 options · 6:10 PM\n                    </p>\n                </div>\n            </li>\n            <li class=\"flex items-start gap-3 py-[15px]\" data-kid=\"1-2-6-3\" data-name=\"activity list item\">\n                <i aria-hidden=\"true\" class=\"ti ti-coin mt-[3px] text-[18px] leading-none text-[#a6a196]\" data-kid=\"1-2-6-3-1\" data-name=\"coin flip icon\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-6-3-2\" data-name=\"activity content block\">\n                    <p class=\"isabi-serif text-[18px] font-semibold leading-[24px] text-[#ece7dd]\" data-kid=\"1-2-6-3-2-1\" data-name=\"activity result title\">\n                        No\n                    </p>\n                    <p class=\"mt-1 text-[13px] leading-[18px] text-[#a6a196]\" data-kid=\"1-2-6-3-2-2\" data-name=\"activity meta text\">\n                        Yes / No flip · 11:53 AM\n                    </p>\n                </div>\n            </li>\n        </ul>\n        <!-- Basement note -->\n        <p class=\"mt-9 flex items-start gap-2.5 border-t border-[#313a2e] pt-5 text-[13.5px] leading-[20px] text-[#a6a196]\" data-kid=\"1-2-7\" data-name=\"basement footnote with separator\">\n            <i aria-hidden=\"true\" class=\"ti ti-wifi-off mt-[1px] text-[18px] leading-none text-[#a6a196]\" data-kid=\"1-2-7-1\" data-name=\"wifi off icon\">\n            </i>\n            <span data-kid=\"1-2-7-2\" data-name=\"basement note text\">\n                History is stored in this browser. Clearing site data removes it.\n            </span>\n        </p>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-16T01:57:14.237397+00:00",
      "modified": "2026-10-16T01:57:22.908134+00:00",
      "id": "var_5b859abc33b2",
      "contentHeight": 960
    },
    "var_e92b8803fffe": {
      "type": "variant",
      "label": "Result · the lot has fallen on · Dark",
      "parentId": "var_0c1aafcff818",
      "themeId": null,
      "rect": {
        "x": 4275,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n\n  @keyframes outcomeIn {\n    from { opacity: 0; transform: scale(0.92); }\n    to   { opacity: 1; transform: scale(1); }\n  }\n  .outcome-card {\n    animation: outcomeIn 0.35s ease-out both;\n  }\n</style>\n<div class=\"flex min-h-[812px] w-full flex-col bg-[#151814] text-[#ece7dd] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;\">\n    <!-- Header -->\n    <header class=\"flex h-14 shrink-0 items-center justify-between border-b border-[#313a2e] bg-[#151814] px-5\" data-kid=\"1-1\" data-name=\"header bar with brand and back action\">\n        <div class=\"flex items-center gap-2\" data-kid=\"1-1-1\" data-name=\"brand identity group\">\n            <i aria-hidden=\"true\" class=\"ti ti-coin text-[20px] leading-none text-[#d4b678]\" data-kid=\"1-1-1-1\" data-name=\"coin brand icon\">\n            </i>\n            <span class=\"text-[17px] font-semibold leading-6 tracking-[-0.01em] text-[#ece7dd]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\" style=\"font-family: 'Source Serif 4', Georgia, 'Times New Roman', serif;\">\n                IsabiCasta\n            </span>\n        </div>\n        <button class=\"-mr-2 flex h-11 items-center gap-1.5 px-2 text-[15px] font-medium text-[#a6a196] transition-colors hover:text-[#ece7dd]\" data-kid=\"1-1-2\" data-name=\"back to home navigation button\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"ti ti-arrow-left text-[20px] leading-none\" data-kid=\"1-1-2-1\" data-name=\"left arrow icon\">\n            </i>\n            <span data-kid=\"1-1-2-2\" data-name=\"back button label\">\n                Home\n            </span>\n        </button>\n    </header>\n    <!-- Body -->\n    <main class=\"flex flex-1 flex-col px-5 pb-7 pt-5\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- The card is centred in the space between the header and the actions,\n         so the whitespace above and below it stays balanced rather than stranding\n         a dead band in the middle of the screen. -->\n        <div class=\"flex flex-1 items-center\" data-kid=\"1-2-1\" data-name=\"outcome card vertical centering wrapper\">\n            <section class=\"outcome-card relative w-full overflow-hidden rounded-[18px] border border-[#313a2e] bg-[#1e231d] px-7 py-8 shadow-[0_6px_18px_rgba(0,0,0,0.35)]\" data-kid=\"1-2-1-1\" data-name=\"outcome celebration card\">\n                <div class=\"text-center\" data-kid=\"1-2-1-1-1\" data-name=\"outcome card headline block\">\n                    <p class=\"text-[14px] font-medium leading-5 tracking-[0.01em] text-[#a6a196]\" data-kid=\"1-2-1-1-1-1\" data-name=\"outcome eyebrow text\">\n                        The lot has fallen on\n                    </p>\n                    <p class=\"relative mt-3 break-words text-[28px] font-semibold leading-9 text-[#b9d3bc]\" data-kid=\"1-2-1-1-1-2\" data-name=\"drawn outcome result text\" style=\"font-family: 'Source Serif 4', Georgia, 'Times New Roman', serif;\">\n                        <!-- the entire celebration budget: one soft gold glow, no ring, no badge -->\n                        <span aria-hidden=\"true\" class=\"pointer-events-none absolute left-1/2 top-1/2 h-44 w-44 -translate-x-1/2 -translate-y-1/2 rounded-full\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"soft gold decorative glow behind result text\" style=\"background: radial-gradient(circle, rgba(212,182,120,0.16) 0%, rgba(212,182,120,0.05) 50%, rgba(212,182,120,0) 70%);\">\n                        </span>\n                        <span class=\"relative\" data-kid=\"1-2-1-1-1-2-2\" data-name=\"drawn outcome label\">\n                            Go out\n                        </span>\n                    </p>\n                </div>\n                <div class=\"my-7 h-px w-full bg-[#313a2e]\" data-kid=\"1-2-1-1-2\" data-name=\"outcome division for cast lots action\">\n                </div>\n                <div class=\"text-center\" data-kid=\"1-2-1-1-3\" data-name=\"outcome footer block\">\n                    <p class=\"text-[15.5px] leading-6 text-[#ece7dd]\" data-kid=\"1-2-1-1-3-1\" data-name=\"outcome affirmation message\">\n                        You’ve made a choice — well done for taking the step.\n                    </p>\n                    <p class=\"mt-3 text-[13px] leading-[18px] text-[#a6a196]\" data-kid=\"1-2-1-1-3-2\" data-name=\"cast lots options meta text\">\n                        Cast lots · 3 options\n                    </p>\n                </div>\n            </section>\n        </div>\n        <!-- Actions: one filled primary, one plain-text secondary -->\n        <div class=\"mt-7 flex flex-col gap-1\" data-kid=\"1-2-2\" data-name=\"outcome actions group\">\n            <button class=\"flex h-12 w-full items-center justify-center gap-2 rounded-[10px] bg-[#4f7455] text-[16px] font-semibold text-[#f6f2ea] transition-colors hover:bg-[#456548]\" data-kid=\"1-2-2-1\" data-name=\"primary try again button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-refresh text-[18px] leading-none\" data-kid=\"1-2-2-1-1\" data-name=\"refresh icon\">\n                </i>\n                <span data-kid=\"1-2-2-1-2\" data-name=\"try again button label\">\n                    Try again\n                </span>\n            </button>\n            <button class=\"flex h-11 w-full items-center justify-center rounded-[10px] text-[15px] font-medium text-[#b9d3bc] transition-colors hover:bg-[rgba(185,211,188,0.08)]\" data-kid=\"1-2-2-2\" data-name=\"edit options secondary button\" type=\"button\">\n                Edit options\n            </button>\n        </div>\n        <!-- Local promise -->\n        <div class=\"mt-8 flex items-center justify-center gap-2\" data-kid=\"1-2-3\" data-name=\"local storage notice row\">\n            <i aria-hidden=\"true\" class=\"ti ti-wifi-off text-[18px] leading-none text-[#a6a196]\" data-kid=\"1-2-3-1\" data-name=\"wifi-off offline icon\">\n            </i>\n            <span class=\"text-[13.5px] leading-5 text-[#a6a196]\" data-kid=\"1-2-3-2\" data-name=\"local storage notice text\">\n                Saved in this browser only.\n            </span>\n        </div>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-16T01:57:14.535933+00:00",
      "modified": "2026-10-16T01:57:23.044843+00:00",
      "id": "var_e92b8803fffe",
      "contentHeight": 812
    },
    "var_0f949d9e3a95": {
      "type": "variant",
      "label": "Cast lots · options input · Dark",
      "parentId": "var_76df0bce31c3",
      "themeId": null,
      "rect": {
        "x": 475,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&family=Inter:wght@400;500;600&display=swap\");\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n\n  .ic-serif { font-family: 'Source Serif 4', Georgia, 'Times New Roman', serif; }\n  .ic-sans { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif; }\n\n  .ic-input::placeholder { color: rgba(166, 161, 150, 0.78); }\n  .ic-input:focus {\n    outline: none;\n    border-color: #7fa383;\n    box-shadow: 0 0 0 3px rgba(127, 163, 131, 0.18);\n  }\n  .ic-btn:active { transform: scale(0.985); }\n</style>\n<div class=\"ic-sans flex min-h-screen flex-col bg-[#151814] text-[#ece7dd] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Header -->\n    <header class=\"flex h-[56px] shrink-0 items-center justify-between border-b border-[#313a2e] bg-[#151814] px-5\" data-kid=\"1-1\" data-name=\"app header bar\">\n        <div class=\"flex items-center gap-2\" data-kid=\"1-1-1\" data-name=\"brand logo group\">\n            <i class=\"ti ti-coin text-[20px] leading-none text-[#d4b678]\" data-kid=\"1-1-1-1\" data-name=\"coin brand icon\">\n            </i>\n            <span class=\"ic-serif text-[17px] font-semibold leading-none tracking-[-0.01em]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                IsabiCasta\n            </span>\n        </div>\n        <button class=\"flex h-11 items-center gap-1.5 pr-1 text-[15px] font-medium leading-none text-[#a6a196]\" data-kid=\"1-1-2\" data-name=\"back to home button\" type=\"button\">\n            <i class=\"ti ti-arrow-left text-[18px] leading-none\" data-kid=\"1-1-2-1\" data-name=\"left arrow back icon\">\n            </i>\n            Home\n        </button>\n    </header>\n    <main class=\"flex flex-1 flex-col px-5 pb-8 pt-6\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Title + description -->\n        <h1 class=\"ic-serif shrink-0 text-[24px] font-semibold leading-[30px] text-[#b9d3bc]\" data-kid=\"1-2-1\" data-name=\"page headline text\">\n            Cast Lots\n        </h1>\n        <p class=\"mt-2 shrink-0 text-[15px] leading-6 text-[#a6a196]\" data-kid=\"1-2-2\" data-name=\"page description text\">\n            Enter your options, one per line. The lot will choose one.\n        </p>\n        <!-- Options field — the hero of the form -->\n        <div class=\"mt-7 shrink-0\" data-kid=\"1-2-3\" data-name=\"options input section\">\n            <label class=\"block text-[15px] font-semibold leading-5 text-[#ece7dd]\" data-kid=\"1-2-3-1\" data-name=\"options field label\" for=\"options\">\n                Your options\n            </label>\n            <textarea class=\"ic-input mt-2 block h-[212px] w-full resize-none rounded-[12px] border-[1.5px] border-[#313a2e] bg-[#1e231d] px-4 py-[14px] text-[15.5px] leading-[26px] text-[#ece7dd] transition-[border-color,box-shadow] duration-150\" data-kid=\"1-2-3-2\" data-name=\"options text input field\" id=\"options\" placeholder=\"Option A\nOption B\nOption C\" rows=\"6\">Stay home\nGo out\nAsk a friend</textarea>\n            <!-- Live count + minimum rule, adjacent to the field -->\n            <div class=\"pt-3\" data-kid=\"1-2-3-3\" data-name=\"validation status block\">\n                <p class=\"flex items-center gap-1.5 text-[13.5px] font-medium leading-5 text-[#9ec3a2]\" data-dynamic=\"true\" data-kid=\"1-2-3-3-1\" data-name=\"valid options status line\" data-reason=\"status text toggled/replaced by live options count script\">\n                    <i class=\"ti ti-check text-[16px] leading-none\" data-kid=\"1-2-3-3-1-1\" data-name=\"green checkmark icon\">\n                    </i>\n                    3 valid options\n                </p>\n                <p class=\"mt-1.5 text-[13.5px] leading-5 text-[#d9a35f]\" data-dynamic=\"true\" data-kid=\"1-2-3-3-2\" data-name=\"minimum options warning text\" data-reason=\"warning text toggled/replaced by live minimum-options validation script\">\n                    1 valid option — need at least 2\n                </p>\n            </div>\n        </div>\n        <!-- Primary action -->\n        <button class=\"ic-btn mt-8 flex h-12 w-full shrink-0 items-center justify-center rounded-[10px] bg-[#4f7455] text-[15.5px] font-semibold leading-none text-[#f6f2ea]\" data-kid=\"1-2-4\" data-name=\"primary cast lots button\" type=\"button\">\n            Cast lots\n        </button>\n        <!-- Local-only statement -->\n        <p class=\"mt-4 flex shrink-0 items-start gap-2 text-[13.5px] leading-5 text-[#a6a196]\" data-kid=\"1-2-5\" data-name=\"local-only privacy note\">\n            <i class=\"ti ti-wifi-off mt-[1px] text-[18px] leading-none text-[#a6a196]\" data-kid=\"1-2-5-1\" data-name=\"wifi off icon\">\n            </i>\n            <span data-kid=\"1-2-5-2\" data-name=\"privacy note text\">\n                Runs in your browser. Nothing you type is sent anywhere.\n            </span>\n        </p>\n        <!-- Documented disabled state -->\n        <div class=\"mt-auto shrink-0 border-t border-[#313a2e] pt-5\" data-kid=\"1-2-6\" data-name=\"disabled state demo section\">\n            <p class=\"text-[13px] leading-[18px] text-[#a6a196]\" data-kid=\"1-2-6-1\" data-name=\"disabled state caption text\">\n                Disabled — fewer than 2 options\n            </p>\n            <button class=\"mt-3 flex h-12 w-[200px] cursor-not-allowed items-center justify-center rounded-[10px] bg-[#4f7455] text-[15.5px] font-semibold leading-none text-[#f6f2ea] opacity-[0.55]\" data-kid=\"1-2-6-2\" data-name=\"disabled cast lots button\" disabled=\"\" type=\"button\">\n                Cast lots\n            </button>\n        </div>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-16T01:57:14.830195+00:00",
      "modified": "2026-10-16T01:57:37.100294+00:00",
