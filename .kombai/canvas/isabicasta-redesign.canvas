    "var_76df0bce31c3": {
      "type": "variant",
      "label": "Cast lots · options input",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&family=Inter:wght@400;500;600&display=swap\");\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n\n  .ic-serif { font-family: 'Source Serif 4', Georgia, 'Times New Roman', serif; }\n  .ic-sans { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif; }\n\n  .ic-input::placeholder { color: rgba(92, 92, 92, 0.55); }\n  .ic-input:focus {\n    outline: none;\n    border-color: #3d5a40;\n    box-shadow: 0 0 0 3px rgba(61, 90, 64, 0.15);\n  }\n  .ic-btn:active { transform: scale(0.985); }\n</style>\n<div class=\"ic-sans flex min-h-screen flex-col bg-[#f7f4ef] text-[#2a2a2a] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Header -->\n    <header class=\"flex h-[56px] shrink-0 items-center justify-between border-b border-[#e0d9ce] bg-[#f7f4ef] px-5\" data-kid=\"1-1\" data-name=\"app header bar\">\n        <div class=\"flex items-center gap-2\" data-kid=\"1-1-1\" data-name=\"brand logo group\">\n            <i class=\"ti ti-coin text-[20px] leading-none text-[#c4a35a]\" data-kid=\"1-1-1-1\" data-name=\"coin brand icon\">\n            </i>\n            <span class=\"ic-serif text-[17px] font-semibold leading-none tracking-[-0.01em]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                IsabiCasta\n            </span>\n        </div>\n        <button class=\"flex h-11 items-center gap-1.5 pr-1 text-[15px] font-medium leading-none text-[#5c5c5c]\" data-kid=\"1-1-2\" data-name=\"back to home button\" type=\"button\">\n            <i class=\"ti ti-arrow-left text-[18px] leading-none\" data-kid=\"1-1-2-1\" data-name=\"left arrow back icon\">\n            </i>\n            Home\n        </button>\n    </header>\n    <main class=\"flex flex-1 flex-col px-5 pb-8 pt-6\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Title + description -->\n        <h1 class=\"ic-serif shrink-0 text-[24px] font-semibold leading-[30px]\" data-kid=\"1-2-1\" data-name=\"page headline text\">\n            Cast Lots\n        </h1>\n        <p class=\"mt-2 shrink-0 text-[15px] leading-6 text-[#5c5c5c]\" data-kid=\"1-2-2\" data-name=\"page description text\">\n            Enter your options, one per line. The lot will choose one.\n        </p>\n        <!-- Options field — the hero of the form -->\n        <div class=\"mt-7 shrink-0\" data-kid=\"1-2-3\" data-name=\"options input section\">\n            <label class=\"block text-[15px] font-semibold leading-5\" data-kid=\"1-2-3-1\" data-name=\"options field label\" for=\"options\">\n                Your options\n            </label>\n            <textarea class=\"ic-input mt-2 block h-[212px] w-full resize-none rounded-[12px] border-[1.5px] border-[#e0d9ce] bg-white px-4 py-[14px] text-[15.5px] leading-[26px] text-[#2a2a2a] transition-[border-color,box-shadow] duration-150\" data-kid=\"1-2-3-2\" data-name=\"options text input field\" id=\"options\" placeholder=\"Option A\nOption B\nOption C\" rows=\"6\">Stay home\nGo out\nAsk a friend</textarea>\n            <!-- Live count + minimum rule, adjacent to the field -->\n            <div class=\"pt-3\" data-kid=\"1-2-3-3\" data-name=\"validation status block\">\n                <p class=\"flex items-center gap-1.5 text-[13.5px] font-medium leading-5 text-[#3d5a40]\" data-dynamic=\"true\" data-kid=\"1-2-3-3-1\" data-name=\"valid options status line\" data-reason=\"status text toggled/replaced by live options count script\">\n                    <i class=\"ti ti-check text-[16px] leading-none\" data-kid=\"1-2-3-3-1-1\" data-name=\"green checkmark icon\">\n                    </i>\n                    3 valid options\n                </p>\n                <p class=\"mt-1.5 text-[13.5px] leading-5 text-[#b45309]\" data-dynamic=\"true\" data-kid=\"1-2-3-3-2\" data-name=\"minimum options warning text\" data-reason=\"warning text toggled/replaced by live minimum-options validation script\">\n                    1 valid option — need at least 2\n                </p>\n            </div>\n        </div>\n        <!-- Primary action -->\n        <button class=\"ic-btn mt-8 flex h-12 w-full shrink-0 items-center justify-center rounded-[10px] bg-[#3d5a40] text-[15.5px] font-semibold leading-none text-white\" data-kid=\"1-2-4\" data-name=\"primary cast lots button\" type=\"button\">\n            Cast lots\n        </button>\n        <!-- Local-only statement -->\n        <p class=\"mt-4 flex shrink-0 items-start gap-2 text-[13.5px] leading-5 text-[#5c5c5c]\" data-kid=\"1-2-5\" data-name=\"local-only privacy note\">\n            <i class=\"ti ti-wifi-off mt-[1px] text-[18px] leading-none text-[#5c5c5c]\" data-kid=\"1-2-5-1\" data-name=\"wifi off icon\">\n            </i>\n            <span data-kid=\"1-2-5-2\" data-name=\"privacy note text\">\n                Runs in your browser. Nothing you type is sent anywhere.\n            </span>\n        </p>\n        <!-- Documented disabled state -->\n        <div class=\"mt-auto shrink-0 border-t border-[#e0d9ce] pt-5\" data-kid=\"1-2-6\" data-name=\"disabled state demo section\">\n            <p class=\"text-[13px] leading-[18px] text-[#5c5c5c]\" data-kid=\"1-2-6-1\" data-name=\"disabled state caption text\">\n                Disabled — fewer than 2 options\n            </p>\n            <button class=\"mt-3 flex h-12 w-[200px] cursor-not-allowed items-center justify-center rounded-[10px] bg-[#3d5a40] text-[15.5px] font-semibold leading-none text-white opacity-[0.55]\" data-kid=\"1-2-6-2\" data-name=\"disabled cast lots button\" disabled=\"\" type=\"button\">\n                Cast lots\n            </button>\n        </div>\n    </main>\n</div>\n",
