    "var_f1cc50978a19": {
      "type": "variant",
      "label": "Home · Dark",
      "parentId": "var_5db6b56777e1",
      "themeId": null,
      "rect": {
        "x": 5225,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&family=Inter:wght@400;500;600&display=swap\");\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n</style>\n<div class=\"flex min-h-[812px] w-full flex-col bg-[#151814] text-[#ece7dd] antialiased\" data-kid=\"3\" data-name=\"page layout container\" style=\"font-family: 'Inter', system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;\">\n    <!-- Header -->\n    <header class=\"flex h-14 shrink-0 items-center justify-between border-b border-[#313a2e] bg-[#151814] px-5\" data-kid=\"3-1\" data-name=\"top app header bar\">\n        <div class=\"flex items-center gap-2.5\" data-kid=\"3-1-1\" data-name=\"brand logo group\">\n            <i aria-hidden=\"true\" class=\"ti ti-coin text-[20px] leading-none text-[#d4b678]\" data-kid=\"3-1-1-1\" data-name=\"coin logo icon\">\n            </i>\n            <span class=\"text-[17px] font-semibold leading-[24px] tracking-[-0.01em] text-[#b9d3bc]\" data-kid=\"3-1-1-2\" data-name=\"brand name text\" style=\"font-family: 'Source Serif 4', Georgia, serif;\">\n                IsabiCasta\n            </span>\n        </div>\n        <button aria-label=\"Light appearance\" class=\"flex size-10 items-center justify-center rounded-full border border-[#313a2e] bg-[#1e231d] text-[#a6a196] hover:bg-[#252b23] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d4b678]\" data-kid=\"3-1-2\" data-name=\"light mode toggle button\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"ti ti-moon text-[20px] leading-none\" data-kid=\"3-1-2-1\" data-name=\"moon icon\">\n            </i>\n        </button>\n    </header>\n    <main class=\"flex flex-1 flex-col px-5 pt-8 pb-9\" data-kid=\"3-2\" data-name=\"main content area\">\n        <!-- Intro -->\n        <div data-kid=\"3-2-1\" data-name=\"intro heading block\">\n            <h1 class=\"text-[19px] font-semibold leading-[28px] tracking-[-0.005em] text-[#ece7dd]\" data-kid=\"3-2-1-1\" data-name=\"hero headline text\" style=\"font-family: 'Source Serif 4', Georgia, serif;\">\n                A simple way to decide when you are stuck.\n            </h1>\n            <p class=\"mt-2 text-[15px] leading-[24px] text-[#a6a196]\" data-kid=\"3-2-1-2\" data-name=\"hero subheading text\">\n                Inspired by the biblical practice of casting lots.\n            </p>\n        </div>\n        <!-- The two actions -->\n        <nav aria-label=\"Choose how to decide\" class=\"mt-10\" data-kid=\"3-2-2\" data-name=\"decision options navigation\">\n            <button class=\"flex min-h-[92px] w-full items-center gap-4 text-left transition-[background-color] duration-200 hover:bg-[rgba(143,184,148,0.05)] focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#d4b678]\" data-kid=\"3-2-2-1\" data-name=\"flip a coin action button\" type=\"button\">\n                <span class=\"flex size-11 shrink-0 items-center justify-center rounded-full bg-[rgba(143,184,148,0.10)]\" data-kid=\"3-2-2-1-1\" data-name=\"coin icon badge circle\">\n                    <i aria-hidden=\"true\" class=\"ti ti-coin text-[22px] leading-none text-[#9ec3a2]\" data-kid=\"3-2-2-1-1-1\" data-name=\"coin icon\">\n                    </i>\n                </span>\n                <span class=\"min-w-0 flex-1\" data-kid=\"3-2-2-1-2\" data-name=\"flip a coin label group\">\n                    <span class=\"block text-[17px] font-semibold leading-[24px] text-[#ece7dd]\" data-kid=\"3-2-2-1-2-1\" data-name=\"flip a coin title\">\n                        Flip a Coin\n                    </span>\n                    <span class=\"mt-1 block text-[15px] leading-[22px] text-[#a6a196]\" data-kid=\"3-2-2-1-2-2\" data-name=\"flip a coin description\">\n                        Yes / No, or Heads / Tails\n                    </span>\n                </span>\n                <i aria-hidden=\"true\" class=\"ti ti-chevron-right text-[18px] leading-none text-[#8b947f]\" data-kid=\"3-2-2-1-3\" data-name=\"chevron right arrow icon\">\n                </i>\n            </button>\n            <div class=\"ml-15 h-px bg-[#313a2e]\" data-kid=\"3-2-2-2\" data-name=\"divider line\">\n            </div>\n            <button class=\"flex min-h-[92px] w-full items-center gap-4 text-left transition-[background-color] duration-200 hover:bg-[rgba(143,184,148,0.05)] focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#d4b678]\" data-kid=\"3-2-2-3\" data-name=\"cast lots action button\" type=\"button\">\n                <span class=\"flex size-11 shrink-0 items-center justify-center rounded-full bg-[rgba(212,182,120,0.12)]\" data-kid=\"3-2-2-3-1\" data-name=\"list icon badge circle\">\n                    <i aria-hidden=\"true\" class=\"ti ti-list text-[22px] leading-none text-[#d4b678]\" data-kid=\"3-2-2-3-1-1\" data-name=\"list icon\">\n                    </i>\n                </span>\n                <span class=\"min-w-0 flex-1\" data-kid=\"3-2-2-3-2\" data-name=\"cast lots label group\">\n                    <span class=\"block text-[17px] font-semibold leading-[24px] text-[#ece7dd]\" data-kid=\"3-2-2-3-2-1\" data-name=\"cast lots title\">\n                        Cast Lots\n                    </span>\n                    <span class=\"mt-1 block text-[15px] leading-[22px] text-[#a6a196]\" data-kid=\"3-2-2-3-2-2\" data-name=\"cast lots description\">\n                        One option per line, then draw\n                    </span>\n                </span>\n                <i aria-hidden=\"true\" class=\"ti ti-chevron-right text-[18px] leading-none text-[#8b947f]\" data-kid=\"3-2-2-3-3\" data-name=\"chevron right arrow icon\">\n                </i>\n            </button>\n        </nav>\n        <!-- Quiet continuity line -->\n        <div class=\"mt-8 flex items-center gap-3\" data-kid=\"3-2-3\" data-name=\"last decision summary row\">\n            <i aria-hidden=\"true\" class=\"ti ti-history text-[18px] leading-none text-[#8b947f]\" data-kid=\"3-2-3-1\" data-name=\"history icon\">\n            </i>\n            <p class=\"min-w-0 flex-1 truncate text-[14px] leading-[22px] text-[#a6a196]\" data-dynamic=\"true\" data-kid=\"3-2-3-2\" data-name=\"last decision summary text\" data-reason=\"text rewritten by script with most recent decision and timestamp\">\n                Last:\n                <strong class=\"font-semibold text-[#ece7dd]\" data-dynamic=\"true\" data-kid=\"3-2-3-2-1\" data-name=\"result label text\" data-reason=\"text replaced by script with latest decision outcome\">\n                    Yes\n                </strong>\n                <span class=\"px-1 text-[#5f6957]\" data-kid=\"3-2-3-2-2\" data-name=\"dot separator\">\n                    ·\n                </span>\n                Yes/No flip\n                <span class=\"px-1 text-[#5f6957]\" data-kid=\"3-2-3-2-3\" data-name=\"dot separator\">\n                    ·\n                </span>\n                9:14 AM\n            </p>\n            <button class=\"flex min-h-11 shrink-0 items-center px-1 text-[14px] font-medium leading-[22px] text-[#b9d3bc] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d4b678]\" data-kid=\"3-2-3-3\" data-name=\"view all decisions button\" type=\"button\">\n                View all\n            </button>\n        </div>\n        <!-- Local / offline statement, anchored at the foot -->\n        <div class=\"mt-auto border-t border-[#313a2e] pt-6\" data-kid=\"3-2-4\" data-name=\"offline statement footer block\">\n            <div class=\"flex items-start gap-3\" data-kid=\"3-2-4-1\" data-name=\"offline statement group\">\n                <i aria-hidden=\"true\" class=\"ti ti-wifi-off mt-0.5 text-[18px] leading-none text-[#a6a196]\" data-kid=\"3-2-4-1-1\" data-name=\"wifi off icon\">\n                </i>\n                <p class=\"text-[15px] leading-[24px] text-[#a6a196]\" data-kid=\"3-2-4-1-2\" data-name=\"offline statement text\">\n                    Works offline. Nothing you type leaves this device.\n                </p>\n            </div>\n            <button class=\"mt-2 ml-7 flex min-h-11 items-center gap-1 text-[14px] font-medium leading-[22px] text-[#b9d3bc] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d4b678]\" data-kid=\"3-2-4-2\" data-name=\"how this works button\" type=\"button\">\n                How this works\n                <i aria-hidden=\"true\" class=\"ti ti-chevron-right text-[15px] leading-none\" data-kid=\"3-2-4-2-1\" data-name=\"chevron right arrow icon\">\n                </i>\n            </button>\n        </div>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-16T01:57:15.029614+00:00",
      "modified": "2026-10-16T01:57:36.821868+00:00",
      "id": "var_f1cc50978a19",
      "contentHeight": 812
    },
    "var_7cad495f536a": {
      "type": "variant",
      "label": "Coin flip · yes/no + heads/tails · Dark",
      "parentId": "var_604e8fbca74e",
