      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&family=Inter:wght@400;500;600&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n\n  .isabi-ui {\n    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n    font-feature-settings: 'cv11', 'ss01';\n  }\n  .isabi-serif {\n    font-family: 'Source Serif 4', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;\n  }\n</style>\n<div class=\"isabi-ui min-h-[812px] bg-[#f7f4ef] text-[#2a2a2a] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Header -->\n    <header class=\"sticky top-0 z-10 border-b border-[#e0d9ce] bg-[#f7f4ef]/95 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"sticky app header bar\">\n        <div class=\"mx-auto flex h-14 w-full max-w-[375px] items-center justify-between px-5\" data-kid=\"1-1-1\" data-name=\"header inner row\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo group\">\n                <i aria-hidden=\"true\" class=\"ti ti-coin text-[20px] leading-none text-[#c4a35a]\" data-kid=\"1-1-1-1-1\" data-name=\"coin icon logo\">\n                </i>\n                <span class=\"isabi-serif text-[17px] font-semibold leading-none tracking-[-0.01em] text-[#2a2a2a]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    IsabiCasta\n                </span>\n            </div>\n            <a class=\"-mr-2 flex min-h-[44px] items-center gap-1.5 px-2 text-[15px] font-medium text-[#5c5c5c]\" data-kid=\"1-1-1-2\" data-name=\"home navigation link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-left text-[18px] leading-none\" data-kid=\"1-1-1-2-1\" data-name=\"left arrow icon\">\n                </i>\n                Home\n            </a>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[375px] px-5 pb-10 pt-6\" data-kid=\"1-2\" data-name=\"main activity feed container\">\n        <!-- Title -->\n        <h1 class=\"isabi-serif text-[24px] font-semibold leading-[30px] tracking-[-0.015em] text-[#2a2a2a]\" data-kid=\"1-2-1\" data-name=\"page title heading\">\n            Recent activity\n        </h1>\n        <!-- Destructive action, deliberately on its own line away from the heading -->\n        <div class=\"mt-2\" data-kid=\"1-2-2\" data-name=\"destructive action wrapper\">\n            <button class=\"inline-flex min-h-[44px] items-center gap-2 text-[14px] font-medium text-[#b91c1c]\" data-kid=\"1-2-2-1\" data-name=\"clear all button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-trash text-[18px] leading-none\" data-kid=\"1-2-2-1-1\" data-name=\"trash icon\">\n                </i>\n                Clear all\n            </button>\n        </div>\n        <!-- Day group: Today -->\n        <p class=\"mt-7 text-[13px] font-medium leading-[18px] text-[#5c5c5c]\" data-kid=\"1-2-3\" data-name=\"day group label today\">\n            Today\n        </p>\n        <ul class=\"mt-1\" data-kid=\"1-2-4\" data-name=\"activity list container\" role=\"list\">\n            <li class=\"flex items-start gap-3 py-[15px]\" data-kid=\"1-2-4-1\" data-name=\"activity list item\">\n                <i aria-hidden=\"true\" class=\"ti ti-coin mt-[3px] text-[18px] leading-none text-[#5c5c5c]\" data-kid=\"1-2-4-1-1\" data-name=\"coin flip icon\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-1-2\" data-name=\"activity content block\">\n                    <p class=\"isabi-serif text-[18px] font-semibold leading-[24px] text-[#2a2a2a]\" data-kid=\"1-2-4-1-2-1\" data-name=\"activity result title\">\n                        Yes\n                    </p>\n                    <p class=\"mt-1 text-[13px] leading-[18px] text-[#5c5c5c]\" data-kid=\"1-2-4-1-2-2\" data-name=\"activity meta text\">\n                        Yes / No flip · 9:14 AM\n                    </p>\n                </div>\n            </li>\n            <li class=\"flex items-start gap-3 py-[15px]\" data-kid=\"1-2-4-2\" data-name=\"activity list item\">\n                <i aria-hidden=\"true\" class=\"ti ti-list mt-[3px] text-[18px] leading-none text-[#5c5c5c]\" data-kid=\"1-2-4-2-1\" data-name=\"list icon\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-2-2\" data-name=\"activity content block\">\n                    <p class=\"isabi-serif text-[18px] font-semibold leading-[24px] text-[#2a2a2a]\" data-kid=\"1-2-4-2-2-1\" data-name=\"activity result title\">\n                        Go out\n                    </p>\n                    <p class=\"mt-1 text-[13px] leading-[18px] text-[#5c5c5c]\" data-kid=\"1-2-4-2-2-2\" data-name=\"activity meta text\">\n                        Cast lots · 3 options · 9:02 AM\n                    </p>\n                </div>\n            </li>\n            <li class=\"flex items-start gap-3 py-[15px]\" data-kid=\"1-2-4-3\" data-name=\"activity list item\">\n                <i aria-hidden=\"true\" class=\"ti ti-coin mt-[3px] text-[18px] leading-none text-[#5c5c5c]\" data-kid=\"1-2-4-3-1\" data-name=\"coin flip icon\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-3-2\" data-name=\"activity content block\">\n                    <p class=\"isabi-serif text-[18px] font-semibold leading-[24px] text-[#2a2a2a]\" data-kid=\"1-2-4-3-2-1\" data-name=\"activity result title\">\n                        Heads\n                    </p>\n                    <p class=\"mt-1 text-[13px] leading-[18px] text-[#5c5c5c]\" data-kid=\"1-2-4-3-2-2\" data-name=\"activity meta text\">\n                        Heads / Tails flip · 8:47 AM\n                    </p>\n                </div>\n            </li>\n            <li class=\"flex items-start gap-3 py-[15px]\" data-kid=\"1-2-4-4\" data-name=\"activity list item\">\n                <i aria-hidden=\"true\" class=\"ti ti-list mt-[3px] text-[18px] leading-none text-[#5c5c5c]\" data-kid=\"1-2-4-4-1\" data-name=\"list icon\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-4-2\" data-name=\"activity content block\">\n                    <p class=\"isabi-serif text-[18px] font-semibold leading-[24px] text-[#2a2a2a] break-words\" data-kid=\"1-2-4-4-2-1\" data-name=\"activity result title\">\n                        Ask a friend instead of staying home this weekend\n                    </p>\n                    <p class=\"mt-1 text-[13px] leading-[18px] text-[#5c5c5c]\" data-kid=\"1-2-4-4-2-2\" data-name=\"activity meta text\">\n                        Cast lots · 4 options · 8:41 AM\n                    </p>\n                </div>\n            </li>\n        </ul>\n        <!-- Day group: Oct 14 -->\n        <p class=\"mt-8 text-[13px] font-medium leading-[18px] text-[#5c5c5c]\" data-kid=\"1-2-5\" data-name=\"day group label Oct 14\">\n            Oct 14\n        </p>\n        <ul class=\"mt-1\" data-kid=\"1-2-6\" data-name=\"activity list container\" role=\"list\">\n            <li class=\"flex items-start gap-3 py-[15px]\" data-kid=\"1-2-6-1\" data-name=\"activity list item\">\n                <i aria-hidden=\"true\" class=\"ti ti-coin mt-[3px] text-[18px] leading-none text-[#5c5c5c]\" data-kid=\"1-2-6-1-1\" data-name=\"coin flip icon\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-6-1-2\" data-name=\"activity content block\">\n                    <p class=\"isabi-serif text-[18px] font-semibold leading-[24px] text-[#2a2a2a]\" data-kid=\"1-2-6-1-2-1\" data-name=\"activity result title\">\n                        Yes\n                    </p>\n                    <p class=\"mt-1 text-[13px] leading-[18px] text-[#5c5c5c]\" data-kid=\"1-2-6-1-2-2\" data-name=\"activity meta text\">\n                        Yes / No flip · 7:28 PM\n                    </p>\n                </div>\n            </li>\n            <li class=\"flex items-start gap-3 py-[15px]\" data-kid=\"1-2-6-2\" data-name=\"activity list item\">\n                <i aria-hidden=\"true\" class=\"ti ti-list mt-[3px] text-[18px] leading-none text-[#5c5c5c]\" data-kid=\"1-2-6-2-1\" data-name=\"list icon\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-6-2-2\" data-name=\"activity content block\">\n                    <p class=\"isabi-serif text-[18px] font-semibold leading-[24px] text-[#2a2a2a]\" data-kid=\"1-2-6-2-2-1\" data-name=\"activity result title\">\n                        Take the early train\n                    </p>\n                    <p class=\"mt-1 text-[13px] leading-[18px] text-[#5c5c5c]\" data-kid=\"1-2-6-2-2-2\" data-name=\"activity meta text\">\n                        Cast lots · 2 options · 6:10 PM\n                    </p>\n                </div>\n            </li>\n            <li class=\"flex items-start gap-3 py-[15px]\" data-kid=\"1-2-6-3\" data-name=\"activity list item\">\n                <i aria-hidden=\"true\" class=\"ti ti-coin mt-[3px] text-[18px] leading-none text-[#5c5c5c]\" data-kid=\"1-2-6-3-1\" data-name=\"coin flip icon\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-6-3-2\" data-name=\"activity content block\">\n                    <p class=\"isabi-serif text-[18px] font-semibold leading-[24px] text-[#2a2a2a]\" data-kid=\"1-2-6-3-2-1\" data-name=\"activity result title\">\n                        No\n                    </p>\n                    <p class=\"mt-1 text-[13px] leading-[18px] text-[#5c5c5c]\" data-kid=\"1-2-6-3-2-2\" data-name=\"activity meta text\">\n                        Yes / No flip · 11:53 AM\n                    </p>\n                </div>\n            </li>\n        </ul>\n        <!-- Basement note -->\n        <p class=\"mt-9 flex items-start gap-2.5 border-t border-[#e0d9ce] pt-5 text-[13.5px] leading-[20px] text-[#5c5c5c]\" data-kid=\"1-2-7\" data-name=\"basement footnote with separator\">\n            <i aria-hidden=\"true\" class=\"ti ti-wifi-off mt-[1px] text-[18px] leading-none text-[#5c5c5c]\" data-kid=\"1-2-7-1\" data-name=\"wifi off icon\">\n            </i>\n            <span data-kid=\"1-2-7-2\" data-name=\"basement note text\">\n                History is stored in this browser. Clearing site data removes it.\n            </span>\n        </p>\n    </main>\n</div>\n",
